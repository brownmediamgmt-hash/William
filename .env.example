# Optional: enables real camera-based plant identification + health/disease detection
# via the Plant.id (Kindwise) API. Sign up for a key at https://plant.id
# Without this set, the app still works fully using the manual plant picker +
# symptom checklist (rule-based diagnosis from the built-in plant database).
PLANT_ID_API_KEY=

# Optional: port to run the server on (defaults to 3000)
PORT=3000
